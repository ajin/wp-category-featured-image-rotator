{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/claude-hook-test.sh post-edit",
            "timeout": 300,
            "statusMessage": "Running lint, boundary checks and PHPUnit..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/claude-hook-test.sh stop",
            "timeout": 300,
            "statusMessage": "Verifying tests pass before finishing..."
          }
        ]
      }
    ]
  }
}
